rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }

    match /bookings/{id} {
      allow read, write: if true;
    }

    match /menuItems/{id} {
      allow read, write: if true;
    }

    match /featuredReels/{id} {
      allow read, write: if true;
    }

    match /reviews/{id} {
      allow read, write: if true;
    }

    match /reelComments/{id} {
      allow read, write: if true;
    }

    match /zomatoOrders/{id} {
      allow read, write: if true;
    }

    match /orders/{id} {
      allow read, write: if true;
    }

    match /restaurantOrders/{id} {
      allow read, write: if true;
    }

    match /driveRecords/{id} {
      allow read, write: if true;
    }
  }
}


